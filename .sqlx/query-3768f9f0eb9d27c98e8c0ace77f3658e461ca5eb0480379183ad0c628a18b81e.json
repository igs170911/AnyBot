  "query": "SELECT l.letter_id, l.account, l.kind, l.device_id, l.content, l.created_at_ms, l.delivered_at_ms, l.state, l.claimed_by FROM mailbox_letters l JOIN computers c ON c.device_id = l.device_id WHERE l.state = 'pending' AND l.kind = 'round' AND (c.online = FALSE OR c.removed_at_ms IS NOT NULL) ORDER BY l.created_at_ms, l.letter_id",
