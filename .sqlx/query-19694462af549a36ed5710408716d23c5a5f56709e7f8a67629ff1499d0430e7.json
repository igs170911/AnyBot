  "query": "SELECT letter_id, account, kind, device_id, content, created_at_ms, delivered_at_ms, state, claimed_by FROM mailbox_letters WHERE state = 'pending' AND kind = 'round' AND device_id <> $1 AND COALESCE(delivered_at_ms, created_at_ms) <= $2 ORDER BY created_at_ms, letter_id",
