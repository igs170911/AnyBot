server-startup-listening = AnyBot server v{ $version }: listening on { $addresses } (database { $db_host }/{ $db_name })
server-db-foreign-data = The database { $db_host }/{ $db_name } contains data that is not AnyBot's: stopping to avoid breaking it.
server-db-connect-retry = Cannot connect to the database { $db_host }: { $reason }; retrying in { $seconds } seconds
server-migration-failed = Database migration failed: { $reason }
server-listen-address-invalid = Listen address { $address } is not a valid address: { $reason }
server-startup-no-accounts = No accounts yet: the first person to register will become this server's admin.
server-startup-invite-generated = Generated invite code { $code }; share it only with people you trust.
server-port-unusable = Cannot use port { $port }: { $reason }
server-arguments-invalid = Command line arguments are invalid: { $reason }
server-bootstrap-missing = Bootstrap file not found (specify it with --bootstrap)
server-bootstrap-file-missing = Bootstrap file { $path } not found (specify it with --bootstrap): { $reason }
server-bootstrap-permissions-read-failed = Reading bootstrap file { $path } permissions failed: { $reason }
server-bootstrap-read-failed = Reading bootstrap file { $path } failed: { $reason }
server-bootstrap-permissions-too-open = Bootstrap file { $path } permissions are too open ({ $mode }): change it so only the owner can read
server-bootstrap-url-malformed = Bootstrap connection URL is malformed
server-bootstrap-url-scheme = Bootstrap connection URL must be a postgresql:// or postgres:// URL
server-bootstrap-credentials-missing = Bootstrap file is missing the database user and password
server-bootstrap-host-missing = Bootstrap file is missing the database host
server-bootstrap-database-missing = Bootstrap file is missing the database name
server-subcommand-unimplemented = This subcommand is not implemented yet: { $command }
server-stop-normal = The server on one of the addresses ended normally
server-stop-error = The server stopped: { $reason }
server-stop-no-listener = No server is serving on any address
client-data-dir-missing = Cannot find the conventional local data directory: specify it with --data-dir
cli-skeleton-banner = anybot { $version } (skeleton, no features)
agent-skeleton-banner = anybot-agent { $version } (skeleton, no features)
runner-service-skeleton-banner = anybot-runner-service { $version } (skeleton, no features)
ui-shell-skeleton = UI skeleton: no features (M2)
app-root-mount-missing = Cannot find the root mount element: index.html has no mount point
problem-bad-request = The request was malformed.
problem-internal = The server hit an internal error.
run-error-protocol-version = The protocol version { $version } is not supported.
run-error-unsupported-event = The event kind { $event } is not supported.
fake-clock-no-future = The fake clock deadline never arrived
model-script-empty = The fake model has no queued responses left
push-payload-short = The web-push payload is too short to contain its salt
push-key-base64 = The web-push subscription key is not valid base64
